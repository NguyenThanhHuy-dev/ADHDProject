# Copy to .env (never commit .env)
DATABASE_URL=postgres://adhd:adhd_dev_password@localhost:5433/adhd_focus
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
PORT=3001
CORS_ORIGIN=http://localhost:5173
# Set to true when running behind nginx or a load balancer (affects client IPs and rate limiting)
TRUST_PROXY=false
# Background jobs (overdue penalties) run in the API process
JOBS_ENABLED=true
JOBS_INTERVAL_MINUTES=1
# Optional: enables "suggest steps" on tasks. Without it the button is hidden.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# Optional: push notifications (task due soon, focus session finished). Create keys with:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
